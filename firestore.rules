// Regras de acesso do banco na nuvem (Cloud Firestore) do Bluebook.
// Cole este conteúdo em: console.firebase.google.com → Firestore Database → Regras → Publicar.
//
// Ideia: cada pessoa tem uma "pasta" própria (usuarios/<id da conta>/...). Só quem está conectado com
// aquela conta lê ou grava ali. Todo o resto do banco é fechado para todo mundo.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dados pessoais: anotações, favoritos, recentes, prescrições, peso do plantão.
    match /usuarios/{uid}/registros/{registro} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      // Gravação: só o dono, com e-mail confirmado pelo provedor de login, registro pequeno e com os campos esperados.
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['tipo', 'chave', 'valor', 'apagado', 'mod', 'aparelho', 'servidor'])
        && request.resource.data.tipo is string && request.resource.data.tipo.size() <= 40
        && request.resource.data.chave is string && request.resource.data.chave.size() <= 300
        && request.resource.data.mod is int
        && request.resource.data.servidor == request.time
        && request.resource.size() < 200000;
    }

    // Qualquer outro caminho: negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
