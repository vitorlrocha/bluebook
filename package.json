{
  "name": "bluebook",
  "version": "0.72.0",
  "private": true,
  "description": "Bluebook — app de consulta clínica offline (arquivo único gerado por build).",
  "scripts": {
    "build": "node ferramentas/build.js",
    "test:build": "node ferramentas/build.js && node ferramentas/testar_build.js",
    "checar": "node ferramentas/checar_sintaxe.js",
    "relatorios": "node ferramentas/pendencias.js && node ferramentas/inconsistencias.js",
    "relatorios:checar": "node ferramentas/pendencias.js --checar && node ferramentas/inconsistencias.js --checar",
    "servir": "node ferramentas/servir.js dist 8080",
    "test": "playwright test",
    "test:celular": "playwright test --project=celular",
    "test:computador": "playwright test --project=computador"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0"
  }
}
